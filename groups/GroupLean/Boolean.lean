/-- The certificate check for all 256 Boolean relations. -/
def boolCheck : Bool := checkAll 2 4096 [0, 2] relB boolReps 0 (words 2 8) boolTable

theorem boolCheck_eq : boolCheck = true := by decide +kernel

open Classical in
/-- The word of a Boolean relation. -/
noncomputable def toWordB (P : Fin 2 → Fin 2 → Fin 2 → Prop) : List ℕ :=
  [if P 0 0 0 then 1 else 0, if P 0 0 1 then 1 else 0, if P 0 1 0 then 1 else 0,
    if P 0 1 1 then 1 else 0, if P 1 0 0 then 1 else 0, if P 1 0 1 then 1 else 0,
    if P 1 1 0 then 1 else 0, if P 1 1 1 then 1 else 0]

lemma toWordB_mem (P : Fin 2 → Fin 2 → Fin 2 → Prop) : toWordB P ∈ words 2 8 := by
  refine mem_words.2 ⟨rfl, ?_⟩
  intro x hx
  simp only [toWordB, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with h | h | h | h | h | h | h | h <;> rw [h] <;> split_ifs <;> decide

private lemma ite_beq_one (p : Prop) {_ : Decidable p} : ((if p then 1 else 0 : ℕ) == 1) = true ↔ p := by
  split_ifs with h <;> simp [h]

lemma nrel_toWordB (P : Fin 2 → Fin 2 → Fin 2 → Prop) (a b c : Fin 2) :
    NRel 2 (relB (toWordB P)) a b c ↔ P a b c := by
  fin_cases a <;> fin_cases b <;> fin_cases c <;> exact ite_beq_one _

private lemma good_cases2 {n : ℕ} {P : Fin n → Fin n → Fin n → Prop} (h : Good [0, 2] P) :
    (RepZ P ∨ RepMod 2 P) ∨ HasGadget P := by
  rcases h with ⟨m, hm, k, hk⟩ | h
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl
    exacts [Or.inl (Or.inl ⟨k, hk⟩), Or.inl (Or.inr ⟨k, hk⟩)]
  · exact Or.inr h

theorem good_boolean (P : Fin 2 → Fin 2 → Fin 2 → Prop) : Good [0, 2] P := by
  have h := good_of_checkAll boolCheck_eq (toWordB P) (toWordB_mem P)
  rcases h with ⟨m, hm, k, hk⟩ | h
  · exact Or.inl ⟨m, hm, k, hk.of_iff (nrel_toWordB P)⟩
  · exact Or.inr (h.of_iff (nrel_toWordB P))

/-- **Theorem D (a).** Every Boolean relation is representable over `ℤ^k` or over `(ZMod 2)^k`
(explicit equation system), or has a one-coordinate OV gadget. -/
theorem boolean_dichotomy (P : Fin 2 → Fin 2 → Fin 2 → Prop) :
    (RepZ P ∨ RepMod 2 P) ∨ HasGadget P :=
  good_cases2 (good_boolean P)

/-- **Theorem D (never both).** -/
theorem boolean_not_both (P : Fin 2 → Fin 2 → Fin 2 → Prop) :
    ¬ ((RepZ P ∨ RepMod 2 P) ∧ HasGadget P) := by
  rintro ⟨⟨k, hk⟩ | ⟨k, hk⟩, hg⟩
  exacts [not_hasGadget_of_rep hk hg, not_hasGadget_of_rep hk hg]

/-- **Theorem D (b).** A Boolean relation is representable over some abelian group iff it has no
one-coordinate OV gadget. -/
theorem boolean_rep_iff (P : Fin 2 → Fin 2 → Fin 2 → Prop) :
    (∃ (A : Type) (_ : AddCommGroup A), RepresentableOver A P) ↔ ¬ HasGadget P :=
  rep_iff_not_hasGadget_of_good (good_boolean P)

/-! ### Theorem D (c): the two non-trivial representable orbits -/

/-- 3XOR: `a ⊕ b ⊕ c = 0`. -/
abbrev xorRel (a b c : Fin 2) : Prop := (a.val + b.val + c.val) % 2 = 0

/-- `c = a + b` over `ℤ` (on bits: `{000, 011, 101}`). -/
abbrev sumRel (a b c : Fin 2) : Prop := c.val = a.val + b.val

theorem xorRel_rep : RepresentableOver (ZMod 2) xorRel :=
  ⟨fun a => (a.val : ZMod 2), fun b => (b.val : ZMod 2), fun c => (c.val : ZMod 2), 0, by
    intro a b c; unfold xorRel; fin_cases a <;> fin_cases b <;> fin_cases c <;> decide⟩

theorem sumRel_rep : RepresentableOver ℤ sumRel :=
  ⟨fun a => (a.val : ℤ), fun b => (b.val : ℤ), fun c => -(c.val : ℤ), 0, by
    intro a b c; unfold sumRel; fin_cases a <;> fin_cases b <;> fin_cases c <;> decide⟩

/-- 3XOR is not representable over a group without 2-torsion (e.g. `ℤ^k`):
`2(φ(001) - t)` is a combination of the equations at `000, 011, 101, 110`. -/
theorem xorRel_not_rep {A : Type*} [AddCommGroup A] (h2 : ∀ x : A, 2 • x = 0 → x = 0) :
    ¬ RepresentableOver A xorRel := by
  rintro ⟨φ₁, φ₂, φ₃, t, h⟩
  have e0 := (h 0 0 0).1 (by decide)
  have e1 := (h 0 1 1).1 (by decide)
  have e2 := (h 1 0 1).1 (by decide)
  have e3 := (h 1 1 0).1 (by decide)
  have : 2 • (φ₁ 0 + φ₂ 0 + φ₃ 1 - t) = 0 := by
    linear_combination (norm := module) e0 + e1 + e2 - e3
  have h001 := (h 0 0 1).2 (sub_eq_zero.1 (h2 _ this))
  exact absurd h001 (by decide)

/-- `c = a + b` is not representable over a group of exponent 2 (e.g. `(ZMod 2)^k`):
`φ(110) = φ(011) + φ(101) - φ(000)` there. -/
theorem sumRel_not_rep {A : Type*} [AddCommGroup A] (h2 : ∀ x : A, 2 • x = 0) :
    ¬ RepresentableOver A sumRel := by
  rintro ⟨φ₁, φ₂, φ₃, t, h⟩
  have e0 := (h 0 0 0).1 (by decide)
  have e1 := (h 0 1 1).1 (by decide)
  have e2 := (h 1 0 1).1 (by decide)
  have z1 := h2 (φ₃ 1)
  have z0 := h2 (φ₃ 0)
  have h110 := (h 1 1 0).2 (by linear_combination (norm := module) e1 + e2 - e0 - z1 + z0)
  exact absurd h110 (by decide)

