/-- A property of all elements of a list follows from the property on its chunks. -/
lemma forall_mem_of_chunks {β : Type*} {L : List β} {K C : ℕ} {Q : β → Prop}
    (hlen : L.length ≤ C * K) (h : ∀ c < C, ∀ w ∈ (L.drop (c * K)).take K, Q w) :
    ∀ w ∈ L, Q w := by
  intro w hw
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hw
  have hK : 0 < K := by
    rcases Nat.eq_zero_or_pos K with h0 | h0
    · rw [h0, Nat.mul_zero] at hlen; omega
    · exact h0
  have hdm := Nat.div_add_mod i K
  have hmod := Nat.mod_lt i hK
  have hc : i / K < C := by
    rw [Nat.div_lt_iff_lt_mul hK]; omega
  have hj : i % K < ((L.drop (i / K * K)).take K).length := by
    rw [List.length_take, List.length_drop, Nat.mul_comm]; omega
  have hm := List.getElem_mem hj
  rw [List.getElem_take, List.getElem_drop] at hm
  have hidx : i / K * K + i % K = i := by rw [Nat.mul_comm]; exact hdm
  simp only [hidx] at hm
  exact h _ hc _ hm

theorem good_fun3_chunk (c T : ℕ) (h : fun3Chunk c T = true) :
    ∀ w ∈ ((words 3 9).drop (c * 1000)).take 1000, Good [0, 2, 3] (NRel 3 (relF w)) :=
  good_of_checkAll h

theorem good_fun3_words : ∀ w ∈ words 3 9, Good [0, 2, 3] (NRel 3 (relF w)) := by
  refine forall_mem_of_chunks (K := 1000) (C := 20) (by decide +kernel) fun c hc => ?_
  exact match c, hc with
  | 0, _ => good_fun3_chunk 0 _ fun3Chunk_0
  | 1, _ => good_fun3_chunk 1 _ fun3Chunk_1
  | 2, _ => good_fun3_chunk 2 _ fun3Chunk_2
  | 3, _ => good_fun3_chunk 3 _ fun3Chunk_3
  | 4, _ => good_fun3_chunk 4 _ fun3Chunk_4
  | 5, _ => good_fun3_chunk 5 _ fun3Chunk_5
