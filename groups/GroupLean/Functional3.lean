/-- The relation `c = g a b`. -/
def graphRel (g : Fin 3 → Fin 3 → Fin 3) (a b c : Fin 3) : Prop := g a b = c

/-- The word of a map. -/
def toWordF (g : Fin 3 → Fin 3 → Fin 3) : List ℕ :=
  [(g 0 0).val, (g 0 1).val, (g 0 2).val, (g 1 0).val, (g 1 1).val, (g 1 2).val,
    (g 2 0).val, (g 2 1).val, (g 2 2).val]

lemma toWordF_mem (g : Fin 3 → Fin 3 → Fin 3) : toWordF g ∈ words 3 9 := by
  refine mem_words.2 ⟨rfl, ?_⟩
  intro x hx
  simp only [toWordF, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with h | h | h | h | h | h | h | h | h <;> rw [h] <;> exact Fin.isLt _

lemma nrel_toWordF (g : Fin 3 → Fin 3 → Fin 3) (a b c : Fin 3) :
    NRel 3 (relF (toWordF g)) a b c ↔ graphRel g a b c := by
  fin_cases a <;> fin_cases b <;>
    simp [NRel, relF, toWordF, graphRel, Fin.ext_iff]

theorem good_functional3 (g : Fin 3 → Fin 3 → Fin 3) : Good [0, 2, 3] (graphRel g) := by
  have h := good_fun3_words (toWordF g) (toWordF_mem g)
  rcases h with ⟨m, hm, k, hk⟩ | h
  · exact Or.inl ⟨m, hm, k, hk.of_iff (nrel_toWordF g)⟩
  · exact Or.inr (h.of_iff (nrel_toWordF g))

/-- **Theorem E.** Every functional relation `c = g a b` over three letters is representable
over `ℤ^k`, `(ZMod 2)^k` or `(ZMod 3)^k`, or has a one-coordinate OV gadget. -/
theorem functional3_dichotomy (g : Fin 3 → Fin 3 → Fin 3) :
    (RepZ (graphRel g) ∨ RepMod 2 (graphRel g) ∨ RepMod 3 (graphRel g)) ∨
      HasGadget (graphRel g) :=
  good_cases (good_functional3 g)

/-- **Theorem E (never both).** -/
theorem functional3_not_both (g : Fin 3 → Fin 3 → Fin 3) :
    ¬ ((RepZ (graphRel g) ∨ RepMod 2 (graphRel g) ∨ RepMod 3 (graphRel g)) ∧
      HasGadget (graphRel g)) := by
  rintro ⟨⟨k, hk⟩ | ⟨k, hk⟩ | ⟨k, hk⟩, hg⟩
  exacts [not_hasGadget_of_rep hk hg, not_hasGadget_of_rep hk hg, not_hasGadget_of_rep hk hg]

/-- **Theorem E (iff form).** `c = g a b` is representable over some abelian group iff it has no
one-coordinate OV gadget. -/
theorem functional3_rep_iff (g : Fin 3 → Fin 3 → Fin 3) :
    (∃ (A : Type) (_ : AddCommGroup A), RepresentableOver A (graphRel g)) ↔
      ¬ HasGadget (graphRel g) :=
  rep_iff_not_hasGadget_of_good (good_functional3 g)

