/-- The certificate check for the words `1000 c, …, 1000 c + 999` (one kernel check per chunk
keeps the memory of each check small). -/
def fun3Chunk (c T : ℕ) : Bool :=
  checkAll 3 65536 [0, 2, 3] relF fun3Reps (c * 1000) (((words 3 9).drop (c * 1000)).take 1000) T

